# ---------------------------------------------------------------
# REQUIRED — Supabase (Project Settings → API)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for canonical URLs, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=https://thetpac.com

# ---------------------------------------------------------------
# OPTIONAL — Email notifications (Resend). Leave empty to disable;
# notifications are then recorded with status "skipped".
# ---------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="TPAC <orders@thetpac.com>"
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------
# OPTIONAL — WhatsApp Business Cloud API (Meta). Leave empty to disable.
# Templates must be approved in Meta Business Manager first.
# ---------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER_UPDATE=order_update
WHATSAPP_TEMPLATE_LANGUAGE=ar
ADMIN_NOTIFICATION_WHATSAPP=

# ---------------------------------------------------------------
# OPTIONAL — Online payments. Not implemented for a specific provider yet;
# the online payment option stays hidden until a provider adapter is
# implemented and these are set. See docs/INTEGRATIONS.md.
# ---------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=

# Secret used to sign internal cron calls (notification retry worker)
CRON_SECRET=
